      "relevance_gate",
      "sufficiency_gate",
      "polarity_if_sufficient",
      "deterministic_relation_mapping",
      "claim_composition"
    ],
    "unknown_construction": "UNKNOWN is produced only when evidence is below the relevance threshold or relevant evidence is below the sufficiency threshold. Native NLI neutral is never directly mapped to UNKNOWN."
