      "role": "score claim-sentence relevance and select the highest-scoring sentence span",
      "decision_score": "single raw sequence-classification logit",
      "max_sequence_length": 512,
      "batch_size": 32
    },
    "sufficiency_polarity": {
      "model_id": "MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli",
