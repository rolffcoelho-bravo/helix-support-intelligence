      "license": "mit",
      "role": "measure whether an aligned span contains sufficient support/refutation evidence and, only when sufficient, determine polarity",
      "native_labels": {
        "0": "entailment",
        "1": "neutral",
        "2": "contradiction"
      },
      "max_sequence_length": 512,
      "batch_size": 16,
      "sufficiency_score": "max(softmax_entailment, softmax_contradiction)",
      "polarity_rule": "if sufficient, entailment > contradiction => SUPPORTS; contradiction > entailment => REFUTES; exact tie => UNRESOLVED"
    }
